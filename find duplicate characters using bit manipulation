import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();

        int seen = 0, dup = 0;

        for (char c : s.toCharArray()) {
            int bit = 1 << (c - 'a');
            if ((seen & bit) != 0)
                dup |= bit;
            seen |= bit;
        }

        int printed = 0;
        boolean found = false;

        for (char c : s.toCharArray()) {
            int bit = 1 << (c - 'a');

            if ((dup & bit) != 0 && (printed & bit) == 0) {
                if (found) System.out.print(" ");
                System.out.print(c);
                printed |= bit;
                found = true;
            }
        }

        if (!found) System.out.print("No duplicates");
    }
}
