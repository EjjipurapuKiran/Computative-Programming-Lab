#include <stdio.h>
int main() {
    int m, n;
    scanf("%d", &m);
    int a[m]; 
    for (int i=0;i<m;i++) {
        scanf("%d", &a[i]);
    }
    scanf("%d", &n);
    int b[n]; 
    for (int i=0;i<n;i++) {
        scanf("%d", &b[i]);
    }
    int c[m + n]; 
    int i = 0; 
    int j = 0; 
    int k = 0; 
    while (i<m && j<n) {
        if (a[i]<b[j]) {
            c[k]=a[i];
            i++;
        } else {
            c[k]=b[j]; 
            j++;
        }
        k++; 
    }
    while (i<m) {
        c[k]=a[i];
        i++;
        k++;
    }
    while (j<n) {
        c[k]=b[j];
        j++;
        k++;
    }
    for (i=0;i<(m + n);i++) {
        printf("%d ",c[i]);
    }
    return 0;
}
